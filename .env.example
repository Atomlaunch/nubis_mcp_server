SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
PORT=3000
# Optional. Privileged HTTP middleware only (server/). Leave empty locally.
# Do not put a DSN in git. Create a Sentry Node/Express project and paste the DSN.
SENTRY_DSN=
# Optional. Defaults to RAILWAY_ENVIRONMENT_NAME or NODE_ENV.
SENTRY_ENVIRONMENT=
# Optional. 0–1. Defaults to 0 (errors only, no traces).
SENTRY_TRACES_SAMPLE_RATE=0
# Optional release tag.
SENTRY_RELEASE=
