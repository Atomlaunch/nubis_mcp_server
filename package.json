{
  "name": "@lil2good/nubis-mcp-server",
  "version": "1.0.64",
  "description": "MCP server for Nubis task management",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "nubis-mcp-server": "build/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "cd server && npm run build",
    "start": "cd server && npm start",
    "dev": "cd server && npm run dev",
    "mcp:build": "tsc",
    "mcp:start": "node build/index.js",
    "mcp:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "mcp:test": "npm run mcp:build && npx --yes tsx src/credentials.test.ts && npx --yes tsx src/boards.test.ts && npx --yes tsx src/tools.test.ts"
  },
  "author": "lil2good",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^16.0.0",
    "node-fetch": "^3.3.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build/",
    "src/",
    "README.md",
    "package.json",
    "tsconfig.json"
  ]
}
